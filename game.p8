pico-8 cartridge // http://www.pico-8.com
version 18
__lua__

#include utils.lua
#include player.lua

state = {
	frame = 0
}

-- debug stuff.
frame_by_frame=false
dbg_on=frame_by_frame
dbg={}
dbc={10}


function _init()
	player:init()
end

holding = true
function _update()
	if frame_by_frame then
		if holding and not btn(4) then
			holding = false
			return
		end
		if btn(4) and not holding then
			holding = true
		else
			return
		end
	end

	dbg = {}

	player:update()

	dbg = player:dbg_txt()

	state.frame += 1
end

function _draw()
	cls(0)

	-- map
	map(0, 0, 0, 0, 128, 128)

	-- if in debug mode, gridlines for collision
	if dbg_on then
		for tile in all(player:tiles()) do
			spr(017, tile.x*8, tile.y*8)
		end
	end

	-- player
	player:draw()

	-- debug text
	if (not dbg_on) return

	for i=1,#dbg do
		local txt = ""
		if dbg[i]!=nil then txt=dbg[i] end
		local col = 7
		if dbc[i]!=nil then col=dbc[i] end
		print(txt, 3, i*6+8,col)
	end
end
