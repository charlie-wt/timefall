pico-8 cartridge // http://www.pico-8.com
version 43
__lua__

#include utils.lua
#include terrain.lua
#include fall.lua
#include player.lua

state = {
	frame = 0,
	cam_pos_tiles = {x=0, y=16}
}

-- debug stuff.
frame_by_frame=false
dbg_on=frame_by_frame
dbg_on_last_toggled=nil
dbg_on_timeout=0.5
dbg={}
dbg_colours={10}
function try_toggle_dbg()
	local now = time()
	if dbg_on_last_toggled == nil or now - dbg_on_last_toggled >= dbg_on_timeout then
		dbg_on = not dbg_on
		frame_by_frame = dbg_on
		dbg_on_last_toggled = now
	end
end

-- tile at screen position {x,y} (in tiles), adjusted for the camera
function tile_at(pos)
	return {x=pos.x + state.cam_pos_tiles.x, y=pos.y + state.cam_pos_tiles.y}
end

function _init()
	player:init()
end

holding = true
function _update()
	if frame_by_frame then
		if holding and not btn(4) then
			holding = false
			return
		end
		if btn(4) and not holding then
			holding = true
		else
			return
		end
	end

	dbg = {}

	player:update()

	dbg = player:dbg_txt()

	state.frame += 1
end

function _draw()
	cls(0)

	-- map
	map(state.cam_pos_tiles.x, state.cam_pos_tiles.y, 0, 0, 128, 128)

	-- if in debug mode, gridlines for collision
	if dbg_on then
		for tile in all(player:tiles()) do
			spr(017, tile.x*8, tile.y*8)
		end
	end

	-- player
	player:draw()

	-- debug text
	if dbg_on then
		for i=1, #dbg do
			local txt = ""
			if dbg[i] != nil then txt = dbg[i] end
			local col = 7
			if dbg_colours[i] != nil then col = dbg_colours[i] end
			print(txt, 3, i*6+8,col)
		end
	end
end
