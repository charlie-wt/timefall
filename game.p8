pico-8 cartridge // http://www.pico-8.com
version 43
__lua__

#include utils.lua
#include terrain.lua
#include platforms.lua
#include sand.lua
#include player.lua
#include flipping.lua

state = {
	-- possible values: menu, intro, gameplay, flipping, lose
	scene = "flipping",
	score_before_current_flip = 0,
	gameplay = {
		bottom_is_bottom = true,

		init = function(self, bottom_is_bottom)
			self.bottom_is_bottom = bottom_is_bottom
			platforms:init()
			sand:init()
			player:init()
		end,

		cam_pos_tiles = function(self)
			if self.bottom_is_bottom then
				return {x=0, y=16}
			else
				return {x=16, y=16}
			end
		end
	},
	flipping = {
		t_started = nil,
		bottom_to_top = true,

		init = function(self, bottom_to_top)
			self.t_started = time()
			self.bottom_to_top = bottom_to_top
		end,

		progress = function(self)
			res = min((time() - self.t_started) / 4, 1)
			if self.bottom_to_top then
				return res
			else
				return 1-res
			end
		end
	}
}

-- debug stuff.
frame_by_frame=false
dbg_on=frame_by_frame
dbg_on_last_toggled=nil
dbg_on_timeout=0.5
dbg={}
dbg_colours={10}
function try_toggle_dbg()
	local now = time()
	if dbg_on_last_toggled == nil or now - dbg_on_last_toggled >= dbg_on_timeout then
		dbg_on = not dbg_on
		frame_by_frame = dbg_on
		dbg_on_last_toggled = now
	end
end

-- get tile at screen position {x,y} (in tiles), adjusted for the camera into an
-- absolute position suitable for indexing the map data
function abs_tile_pos(screen_tile_pos)
	local map_location = state.gameplay:cam_pos_tiles()
	return {x=screen_tile_pos.x + map_location.x,
	        y=screen_tile_pos.y + map_location.y}
end

function tile_is_solid(tile)  -- screen pos tile
	return terrain:tile_solid(tile) or sand:tile_is_sand(tile) or platforms:tile_is_solid(tile)
end

function _init()
	state.scene = "gameplay"
	state.gameplay:init(false)
	state.flipping:init(false)
end

function total_score()
	return state.score_before_current_flip + sand.pieces_dropped
end

function flip_hourglass()
	state.score_before_current_flip += sand.pieces_spawned
	state.gameplay:init(not state.gameplay.bottom_is_bottom)
end

holding = true
function _update()
	if state.scene == "gameplay" then
		if btn(5) then try_toggle_dbg() end

		if frame_by_frame then
			if holding and not btn(4) then
				holding = false
				return
			end
			if btn(4) and not holding then
				holding = true
			else
				return
			end
		end

		dbg = {}

		player:update()
		dbg = player:dbg_txt()

		if player.pos.y < 0 then
			flip_hourglass()
			return
		end

		sand:update()
	elseif state.scene == "flipping" then
		-- TODO #finish
	end
end

function _draw()
	if state.scene == "gameplay" then
		cls(0)

		-- map
		local map_location = state.gameplay:cam_pos_tiles()
		map(map_location.x, map_location.y, 0, 0, 128, 128)

		-- platforms
		platforms:draw()

		-- sand
		sand:draw_sand()

		-- if in debug mode, gridlines for collision
		if dbg_on then
			-- local ptp = pixels(tiles(player.pos))
			-- spr(017, ptp.x, ptp.y)
			for tile in all(player:tiles()) do
				spr(017, tile.x*8, tile.y*8)
			end
		end

		-- player
		player:draw()

		-- ui text
		sand:draw_pieces_remaining(8, 8)
		print(total_score(), 8, 16, 12)

		-- TODO #finish
		if player.is_dead then
			print("dead", 104, 8, 8)
		end

		-- debug text
		if dbg_on then
			for i=1, #dbg do
				local txt = ""
				if dbg[i] != nil then txt = dbg[i] end
				local col = 7
				if dbg_colours[i] != nil then col = dbg_colours[i] end
				print(txt, 3, i*6+8,col)
			end
		end
	elseif state.scene == "flipping" then
		cls(0)
		local y_off = -(1 - cos(state.flipping:progress()/2))/2
		local y_off_total_amt = 128
		camera(-64, -64 - y_off_total_amt*y_off)
		draw_hourglass_top()
		draw_hourglass_bottom()
	end
end
